# Copy to .env and fill in. NEVER commit .env.
#
# NOTE: EXPO_PUBLIC_* values are inlined into the JS bundle and are fully
# public in the shipped APK. That is acceptable here:
#   - Supabase anon key: public by design; Row Level Security is the real boundary.
#   - MapTiler key: the client calls MapTiler directly, so it cannot be hidden.
#     Restrict it by Android package name in the MapTiler dashboard.
# The Supabase service_role key must NEVER appear in this file or the app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MAPTILER_KEY=
