# Credentials for the local station-import scripts ONLY.
# Copy to .env.scripts (git-ignored) and fill in.
#
# The service_role key BYPASSES Row Level Security entirely. It must never
# appear in .env, never be committed, and never ship inside the app. It lives
# here because RLS deliberately forbids the app from writing station data --
# only this local script may.
#
# Both values: Supabase Dashboard > Settings > API.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
